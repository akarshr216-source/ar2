# Dashboard server port (Node.js Vite dashboard runs on 3000)
PORT=3000

# Authoritative Windows Go API bind address and port
NETFUSION_HOST_BIND=0.0.0.0:8080

# Public LAN URL advertised in QR codes (replace with your Windows PC's Wi-Fi IPv4)
NETFUSION_PUBLIC_URL=http://192.168.1.16:8080

# When running the Go API server on 8080 and Node dashboard on 3000, proxy /api/* to Go:
# (Leave empty for standalone Node.js mode; set to http://127.0.0.1:8080 on Windows)
NETFUSION_API_PROXY_TARGET=

# Shared SQLite database path (Windows example: C:\NetFusion\data\netfusion.db)
NETFUSION_DB_PATH=./data/netfusion.db

# Optional administrator passcode for device management (leave blank to claim on first run in UI)
NETFUSION_ADMIN_PASSCODE=

# Heartbeat timeout in seconds before a silent device is marked disconnected
NETFUSION_HEARTBEAT_TIMEOUT_SECONDS=15

# Temporary single-use QR pairing secret lifetime in seconds (2 minutes)
NETFUSION_PAIRING_CODE_TTL_SECONDS=120

# Optional frontend API base URL when hosted separately from dashboard origin
VITE_API_BASE_URL=
