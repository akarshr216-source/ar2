# Server port (AI Studio preview requires 3000)
PORT=3000

# Host bind address and port (Windows example: 0.0.0.0:8080)
NETFUSION_HOST_BIND=0.0.0.0:3000

# Local SQLite database path (Windows example: C:\NetFusion\data\netfusion.db)
NETFUSION_DB_PATH=./data/netfusion.db

# Optional administrator passcode for device management (leave blank to claim on first run in UI)
NETFUSION_ADMIN_PASSCODE=

# Heartbeat timeout in seconds before a silent device is marked disconnected
NETFUSION_HEARTBEAT_TIMEOUT_SECONDS=15

# Temporary single-use pairing code lifetime in seconds
NETFUSION_PAIRING_CODE_TTL_SECONDS=300

# Optional frontend API base URL when hosted separately from server (e.g. http://192.168.1.10:8080)
VITE_API_BASE_URL=
