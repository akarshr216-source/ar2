{
  "application": {
    "name": "NetFusion",
    "version": "0.2.0",
    "theme": "system"
  },
  "server": {
    "enabled": true,
    "startup": "windows_boot",
    "port": 8080,
    "lan_only": true
  },
  "network": {
    "auto_discovery": true,
    "monitor_interval_seconds": 3,
    "automatic_failover": false
  },
  "load_balancing": {
    "enabled": false,
    "algorithm": "weighted_health"
  },
  "streaming": {
    "enabled": false,
    "profile": "automatic",
    "video_priority": 70,
    "gaming_priority": 90,
    "realtime_priority": 100
  },
  "bonding": {
    "enabled": false,
    "relay_mode": "optional"
  },
  "security": {
    "authentication_required": true,
    "encryption": "TLS 1.3"
  }
}
